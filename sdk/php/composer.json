{
    "name": "asmsafone/zaptura",
    "description": "Official PHP SDK for Zaptura WhatsApp API Gateway",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "whatsapp",
        "api",
        "sdk",
        "zaptura",
        "gateway"
    ],
    "authors": [
        {
            "name": "Zaptura Contributors"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Zaptura\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zaptura\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
